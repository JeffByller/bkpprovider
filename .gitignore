# Ignorar banco de dados local com dados e senhas
data/
*.db
*.sqlite3

# Ignorar backups salvos localmente
backups/

# Ignorar variaveis de ambiente locais com senhas
.env

# Ignorar certificados autoassinados gerados localmente
nginx/ssl/*.crt
nginx/ssl/*.key

# Ignorar arquivos temporarios do Python / sistema
__pycache__/
*.pyc
.DS_Store
*.log
